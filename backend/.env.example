PORT=5001
MONGODB_URI=mongodb://localhost:27017/widetechnos
JWT_SECRET=supersecretjwtkeyforwidetechnos2027
PAYU_MERCHANT_KEY=mock_key
PAYU_MERCHANT_SALT=mock_salt
PAYU_BASE_URL=https://test.payu.in
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=youremail@gmail.com
# SMTP_SECURE=true   # use with port 465

# Enquiry notifications: comma-separated address(es) that receive an email for every
# website enquiry (contact form, software & service enquiries). Uses the SMTP settings above.
# Leave empty to only store enquiries in the database (admin portal -> Inquiries).
ENQUIRY_NOTIFY_EMAIL=owner@example.com

# Number of reverse proxies in front of Node (Nginx = 1). Needed so rate limits use the
# real visitor IP. Set to 0 if the API is ever exposed directly without a proxy.
TRUST_PROXY_HOPS=1

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Secret Admin Portal Route Slug (Obscure custom URL so bots/visitors cannot find admin)
ADMIN_SECRET_PATH=wide-admin-portal

# Master Super Admin Credentials
ADMIN_EMAIL=hq-master-control@widetech.in
ADMIN_PASSWORD=your_super_strong_password_here

# ── Software licensing (see docs/LICENSING.md) ─────────────────────────────────────────
# Generate with:  node scripts/generate-license-keypair.mjs
# NEVER commit real values. Keep the private key only on the server.
# Ed25519 private key (base64 PKCS8 DER or PEM). Required in production for /api/license/v1.
LICENSE_SIGNING_PRIVATE_KEY=
# The matching PUBLIC key is not read by the server; it is printed by the script and embedded in
# your desktop apps. You may keep a copy here for reference (it is safe to share).
# LICENSE_SIGNING_PUBLIC_KEY=
# 32+ random characters used to encrypt stored licence keys (so the dashboard can show them).
# Changing it later makes existing keys unreadable in the dashboard (they still validate).
LICENSE_KEY_SECRET=
# Optional rate limits for the public licence API (per IP).
# LICENSE_RATE_LIMIT_PER_MIN=60
# LICENSE_FAIL_LIMIT=20          # failed key/activation attempts per 15 minutes

# ── GST invoice numbering ──────────────────────────────────────────────────────────────
# legacy (default): keeps the current INV-xxxxxx-nnn numbers created at checkout.
# sequential: gap-free series per financial year, e.g. WT/26-27/00001, assigned only after
# payment. Confirm with your CA before switching. Applies to courses, software and services.
INVOICE_SERIES=legacy
# INVOICE_PREFIX=WT

# ── Test payments ──────────────────────────────────────────────────────────────────────
# Mock (fake) payments for local testing only. Ignored when NODE_ENV=production.
# Leave unset/false on the live server.
# ALLOW_MOCK_PAYMENTS=false

# ── Customer dashboard ─────────────────────────────────────────────────────────────────
# How many computers a buyer may remove from a licence themselves per 30 days (default 3;
# 0 = only an admin can). Admins are never limited.
# LICENSE_SELF_DEACTIVATE_PER_30D=3

# Sender name shown in emails (default "WideTech"). APP_LOGO_URL is an optional logo for emails.
# SMTP_FROM_NAME=WideTech
# APP_LOGO_URL=
