# Copy to frontend/.env (never commit real .env files).
# API base URL. Leave unset in production (Nginx proxies /api); dev defaults to http://localhost:5001/api
# VITE_API_URL=

# Public WhatsApp number shown as a single small link in the landing-page enquiry section.
# International format, digits only (e.g. 919876543210). Leave unset to use the number
# already in the codebase (src/config/site.js).
VITE_WHATSAPP_NUMBER=
